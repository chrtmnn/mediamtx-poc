# Copy to .env only if you need to change something. Every value below is the
# default already; leave a line commented out unless you really want to pin it.

# Image tag. The default lives in compose.yaml; setting it here pins it.
#MEDIAMTX_IMAGE_TAG=1.21.4-ffmpeg

# Save every broadcast to RECORDINGS_DIR (true) or only relay it (false).
#RECORD=true

# Where recordings land on the host. On Windows, e.g. D:/Videos/PS5
#RECORDINGS_DIR=./recordings
